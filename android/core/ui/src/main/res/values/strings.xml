    <!-- Host key trust dialog -->
    <string name="trust_title">Trust this host?</string>
    <string name="trust_intro">You’re connecting to %1$s for the first time. Its key identifies the machine, so Flocket can tell if something else answers later.</string>
    <string name="trust_key_type">Key type</string>
    <string name="trust_fingerprint">Fingerprint (SHA-256)</string>
    <string name="trust_explanation">Only continue if this matches the fingerprint on the machine (run ssh-keygen -lf on its host key). Trusting pins this key: Flocket warns you if it ever changes, and sends your credentials only to this key.</string>
    <string name="trust_confirm">Trust and connect</string>
    <string name="changed_title">Host key changed</string>
    <string name="changed_intro">The key for %1$s is not the one you trusted. Flocket has blocked the connection and sent nothing.</string>
    <string name="changed_expected">Pinned key</string>
    <string name="changed_actual">Key now presented</string>
    <string name="changed_warning">If you didn’t reinstall or reconfigure that machine, don’t continue: someone may be intercepting your connection.</string>
    <string name="changed_keep_blocked">Keep blocked</string>
    <string name="changed_forget_title">Forget the pinned key?</string>
    <string name="changed_forget_message">Flocket will delete the key you trusted for %1$s. The next connection asks you to verify the new fingerprint, exactly like a first connection. Do this only if you know why the key changed.</string>
