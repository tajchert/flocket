    <!-- UiError mapping (AppError -> text). Keep in sync with UiError.kt -->
    <string name="error_unreachable_title">Can’t reach the host</string>
    <string name="error_unreachable_message">Flocket couldn’t open a connection to %1$s. Check that the machine is on, that you’re on the same network or Tailscale, and that the address and port are right.</string>
    <string name="error_connection_lost_title">Connection lost</string>
    <string name="error_connection_lost_message">The connection dropped. Flocket reconnects automatically, or you can try again now.</string>
    <string name="error_timeout_title">Timed out</string>
    <string name="error_timeout_message">The host took too long to respond (%1$s). Try again.</string>
    <string name="error_host_key_unknown_title">Verify this host</string>
    <string name="error_host_key_unknown_message">%1$s is showing a key Flocket hasn’t seen before. Compare the fingerprint with the one on the machine before you trust it.</string>
    <string name="error_host_key_changed_title">Host key changed</string>
    <string name="error_host_key_changed_message">%1$s presented a different key than the one you trusted. That can mean a reinstall, or someone intercepting the connection. Flocket will not connect.</string>
    <string name="error_auth_key_title">Sign-in rejected</string>
    <string name="error_auth_key_message">The host refused the key for user “%1$s”. Add this device’s public key to ~/.ssh/authorized_keys on that machine, or check the username.</string>
    <string name="error_auth_password_title">Wrong password</string>
    <string name="error_auth_password_message">The host refused the password for user “%1$s”. Enter it again.</string>
    <string name="error_core_not_found_title">herdr-core not found</string>
    <string name="error_core_not_found_message">Flocket couldn’t run hc on the host. Install herdr-core there, or set the path to hc in the host’s advanced settings.</string>
    <string name="error_core_incompatible_title">herdr-core needs an update</string>
    <string name="error_core_incompatible_message">This version of herdr-core doesn’t work with Flocket: %1$s. Update hc on the host.</string>
